# Development defaults use SQLite. For MySQL use mysql+pymysql://user:password@host:3306/vegz_shop
APP_ENV=development
DATABASE_URL=sqlite:///./vegz_shop.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SHOP_DEMO_CODE=123456
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Must match SHOP_INTERNAL_TOKEN in vegz-user .env; use a random secret of at least 32 characters.
SHOP_INTERNAL_TOKEN=replace-with-the-same-random-secret-used-by-vegz-user

# Admin approval integration. Use the same random token in all four apps.
ADMIN_SERVICE_URL=http://host.docker.internal:8000
PARTNER_ADMIN_TOKEN=replace-with-the-same-random-secret-used-by-vegz-admin
