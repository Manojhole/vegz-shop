{
  "expo": {
    "name": "Vegz Shop",
    "slug": "vegz-shop",
    "scheme": "vegzshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vegz Shop to select product photos."
        }
      ]
    ],
    "android": {
      "package": "online.vegz.shop"
    },
    "ios": {
      "bundleIdentifier": "online.vegz.shop"
    }
  }
}
